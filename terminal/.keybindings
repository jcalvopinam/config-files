#----------------------------------------------------------------------------------
# Keybindings for Terminal, Ghostty, and Herdr
#----------------------------------------------------------------------------------
bindkey -e

# Terminal - Alt + delete
bindkey $'\e[1;3~' backward-kill-word

# Terminal - Alt + Up/Down
bindkey $'\e[A' beginning-of-line
bindkey $'\e[B' end-of-line

# Terminal - Alt + Left/Right
bindkey $'\ef' forward-word
bindkey $'\eb' backward-word

# Ghostty - Alt + Up/Down
bindkey "^[^[[A" beginning-of-line
bindkey "^[^[[B" end-of-line

# Ghostty - Alt + Left/Right
bindkey "^[^[[C" forward-word
bindkey "^[^[[D" backward-word

# Herdr - Alt + Up/Down
bindkey $'\e[1;3A' beginning-of-line
bindkey $'\e[1;3B' end-of-line

# Herdr - Alt + Left/Right
bindkey $'\e[1;3D' backward-word
bindkey $'\e[1;3C' forward-word
