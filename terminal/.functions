#!/usr/bin/env bash
# Functions

#----------------------------------------------------------------------------------
# Text formatting
#----------------------------------------------------------------------------------
BOLD="\e[1m"
RESET="\e[0m"

#----------------------------------------------------------------------------------
# Get the help of a command and format it with `bat` using the `cathelp` alias
#----------------------------------------------------------------------------------
help() {
    "$@" --help 2>&1 | cathelp
}

#----------------------------------------------------------------------------------
# Deletes file/folder with scrub utility. e.g.:rmk myFolder
#----------------------------------------------------------------------------------
function rmk() {
  scrub -p dod $1
  shred -zun 10 -v $1
}

#----------------------------------------------------------------------------------
# Gets the size of a file or total size of a directory. e.g.: fsize ~/Downloads
#----------------------------------------------------------------------------------
function fsize() {
  if du -b /dev/null > /dev/null 2>&1; then
    local arg=-sbh
  else
    local arg=-sh
  fi
  if [[ -n "$@" ]]; then
    du $arg -- "$@"
  else
    du $arg .[^.]* ./*
  fi
}

#----------------------------------------------------------------------------------
# Gets the most useful info about dns. e.g: digga google.com
#----------------------------------------------------------------------------------
function digga() {
  dig +nocmd "$1" any +multiline +noall +answer
}

#----------------------------------------------------------------------------------
# Extract and open project with IntelliJ, currently this only supports "zip" files.
#                    The command uio means Unzip Intellij Open
# Keep in mind that the "idea" command must be enabled, if you aren't sure, please
# open IntelliJ and go to "Tools > Create Command-line Launcher..." and hit "OK"
# sample how to use: uio project-name.zip
# > uio demo.zip
#----------------------------------------------------------------------------------
if type idea &> /dev/null; then
  function uio() {
    project=$1
    filename=$(basename -- "$project")
    extension="${filename##*.}"
    filename="${filename%.*}"

    if [[ "$project" = "" ]]; then
      echo " ::Please enter the file name..."
    else
      if [[ ${extension} == "zip" ]]; then
        unzip -q $project
        echo " ::Checking the project structure ..."
        cd $filename
        if [[ -e pom.xml ]] || [[ -e build.gradle ]]; then
          echo " ::Opening the project" $filename
          cd ..
          idea $filename &
          sleep 5
          echo " "
        else
          cd ..
          rm -rf $filename
          echo " ::The structure of the project is not maven nor gradle"
        fi
      else
        echo " :: Extension file doesn't support...."
      fi
    fi
  }
fi

#----------------------------------------------------------------------------------
# `man` colors
#----------------------------------------------------------------------------------
function man() {
  env \
    LESS_TERMCAP_mb=$'\e[01;31m' \
    LESS_TERMCAP_md=$'\e[01;31m' \
    LESS_TERMCAP_me=$'\e[0m' \
    LESS_TERMCAP_se=$'\e[0m' \
    LESS_TERMCAP_so=$'\e[01;44;33m' \
    LESS_TERMCAP_ue=$'\e[0m' \
    LESS_TERMCAP_us=$'\e[01;32m' \
    man "$@"
}

#----------------------------------------------------------------------------------
# Clean duplicated entries in the zsh history.
# Usage: czsh [options]
#   czsh        -> No args - Keep only the first occurrence of each command
#   czsh f      -> Deduplicate and remove .DS_Store files from $HOME
#   czsh s      -> Deduplicate and sort by command name
#   czsh d      -> Deduplicate and sort by date (oldest first)
#   czsh fs     -> Deduplicate and remove .DS_Store and sort by command
#   czsh fd     -> Deduplicate and remove .DS_Store and sort by date
#----------------------------------------------------------------------------------
if [[ "$SHELL" = "/bin/zsh" ]]; then
  function czsh() {
    local prev_dir="$PWD"
    cd "$HOME" || { echo ":: Error: cannot cd to $HOME"; return 1; }

    if [[ ! -f .zsh_history ]]; then
      echo ":: Error: .zsh_history not found"
      cd "$prev_dir" 2>/dev/null
      return 1
    fi

    # Save nomatch state and disable it for safe globbing
    local nomatch_was_on
    [[ -o nomatch ]] && nomatch_was_on=1 || nomatch_was_on=0
    set +o nomatch

    # Deduplicate history by command (preserves order of first occurrence)
    # First, ensure each entry is on its own line (handles corrupted history files)
    awk '{gsub(/: [0-9]+:[0-9]+;/,"\n&"); if(substr($0,1,1)=="\n") $0=substr($0,2)} 1' .zsh_history | awk -F';' '!seen[$2]++' > .zsh_clean_history

    # Remove old history and related files
    rm -rf .zsh_history .zcompdump* .zsh_sessions
    mv .zsh_clean_history .zsh_history

    # Restore nomatch state
    [[ "$nomatch_was_on" -eq 1 ]] && set -o nomatch

    # Parse arguments
    local clean_ds=false sort_cmds=false sort_date=false
    for arg in "$@"; do
      case "$arg" in
        f) clean_ds=true ;;
        s) sort_cmds=true ;;
        d) sort_date=true ;;
      esac
    done

    if $clean_ds; then
      echo ":: Removing .DS_Store files..."
      find "$HOME" -type f -name ".DS_Store" -delete 2>/dev/null
      echo "...done!"
    fi

    if $sort_cmds; then
      sort -t ';' -k2,2 ".zsh_history" > ".zsh_history.temp"
      mv ".zsh_history.temp" ".zsh_history"
    fi

    if $sort_date; then
      sort -t ';' -k1,1n ".zsh_history" > ".zsh_history.temp"
      mv ".zsh_history.temp" ".zsh_history"
    fi

    cd "$prev_dir" 2>/dev/null
  }
fi

#----------------------------------------------------------------------------------
# `brew` Uninstall a formula
#----------------------------------------------------------------------------------
if type brew &> /dev/null; then
  function unbrew() {
    brew uninstall --force $1 # It deletes the package, data and configuration
    brew cleanup $1
    brew autoremove --dry-run
    brew cleanup
    brew doctor
    rm -rf ~/Library/Caches/Homebrew/downloads
  }
fi

#----------------------------------------------------------------------------------
# `brew` Force update/upgrade formulas and casks
#----------------------------------------------------------------------------------
if type brew &> /dev/null; then
  function upbrew() {
    BOLD=$(tput bold)
    RESET=$(tput sgr0)

    visible_length() {
      echo -n "$1" | sed 's/\x1b\[[0-9;]*m//g' | wc -c | tr -d ' '
    }

    print_table() {
      local title="$1"
      local data="$2"

      max_name=$(visible_length "$title")
      max_current=$(visible_length "CURRENT")
      max_latest=$(visible_length "LATEST")

      while IFS=$'\t' read -r name current latest; do
        (( ${#name} > max_name )) && max_name=${#name}
        (( ${#current} > max_current )) && max_current=${#current}
        (( ${#latest} > max_latest )) && max_latest=${#latest}
      done <<< "$data"

      border="+-$(printf '%*s' "$max_name" | tr ' ' -)-+-$(printf '%*s' "$max_current" | tr ' ' -)-+-$(printf '%*s' "$max_latest" | tr ' ' -)-+"
      header="| ${BOLD}%-${max_name}s${RESET} | ${BOLD}%-${max_current}s${RESET} | ${BOLD}%-${max_latest}s${RESET} |"
      row="| %-$((${max_name}))s | %-$((${max_current}))s | %-$((${max_latest}))s |"

      printf "%s\n" "$border"
      printf "$header\n" "$title" "CURRENT" "LATEST"
      printf "%s\n" "$border"

      while IFS=$'\t' read -r name current latest; do
        printf "$row\n" "$name" "$current" "$latest"
      done <<< "$data"

      printf "%s\n" "$border"
    }

    parse_outdated() {
      # Adjusted to handle the output format of `brew outdated`
      echo "$1" | awk '/<|!=/ {print $1 "\t" $2 "\t" $4}' | sed 's/[()]//g'
    }

    brew update --quiet > /dev/null 2>&1
    formulas_outdated=$(brew outdated --formula --verbose)
    casks_outdated=$(brew outdated --cask --verbose)

    if [[ -z "$formulas_outdated" && -z "$casks_outdated" ]]; then
      echo -e "${BOLD}:: Everything is up to date!${RESET}"
    else
      [ -n "$formulas_outdated" ] && print_table "FORMULAS" "$(parse_outdated "$formulas_outdated")"
      [ -n "$casks_outdated" ] && print_table "CASKS" "$(parse_outdated "$casks_outdated")"

      echo -ne "${BOLD}\n:: Do you want to update all? (y/n): ${RESET}"
      read -r choice

      if [[ "$choice" =~ ^[Yy]$ ]]; then
        brew upgrade --quiet --formula $(brew list --formula)
        brew upgrade --quiet --cask $(brew list --cask)
        brew cleanup
        brew doctor
      else
        echo -e "${BOLD}:: Update canceled!${RESET}"
      fi
    fi
  }
fi

#----------------------------------------------------------------------------------
# `git` reset and clean current branch
#----------------------------------------------------------------------------------
function cbranch() {
  if ! git ls-files &> /dev/null; then
    echo $'Git project not found\n'
    return
  fi
  git reset --hard
  git clean -f -d
}

#----------------------------------------------------------------------------------
# `git` color setup for bash terminal
#----------------------------------------------------------------------------------
if [[ "$SHELL" = "/bin/bash" ]]; then
  parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ (\1)/'
  }
fi

#----------------------------------------------------------------------------------
# `lnal` clean the files
#----------------------------------------------------------------------------------
if type lnav &> /dev/null; then
  function clnav() {
    rm -rf ~/.config/lnav/*.json
    rm -rf ~/.config/lnav/*.history
    rm -rf ~/.config/lnav/crash
  }
fi

#----------------------------------------------------------------------------------
# Gets the total memory consumed by app. e.g.: appname java
#----------------------------------------------------------------------------------
function appmem() {
  ps aux | grep -i "$1" | grep -v "grep" | awk '
  # Adds up the amount of memory used by each process.
  {sum+=$6}

  # At the end of the output, print the total amount in MB or GB
  END {
    # If the total amount is less than 1 GB, shows the amount in MB
    if (sum < 1048576) {
      size = sum / 1024;    # Divide by 1024 to convert to MB
      unit = "MB";          # Add MB text
    }
    # Otherwise, it shows the quantity in GB
    else {
      size = sum / 1048576; # Divide by 1048576 to convert to GB
      unit = "GB";          # Add GB text
    }
    # Print the amount rounded to 2 decimal places
    printf "%.2f %s", size, unit;
  }'
}

#----------------------------------------------------------------------------------
# Shows a pop-up message with sound. e.g.: cmd-notification hello
#----------------------------------------------------------------------------------
function cmd-notification() {
  message=""
  if [ $# -eq 0 ]; then
    message="End process"
  else
    message="$1"
  fi
  osascript -e "display notification \"$message\" sound name \"Basso\""
}

#----------------------------------------------------------------------------------
# `colima` gets the internal IP
#----------------------------------------------------------------------------------
if type colima &> /dev/null; then
  function ipc() {
    result=$(colima status 2>&1)
    ip=$(echo "$result" | awk '/address:/ {print $NF}' | tr -d '"')
    if [ -z "$ip" ]; then
      echo "$result" | awk -F 'msg=' '{print $2}' | cut -d'"' -f2
    else
      echo "$ip"
    fi
  }
fi

#----------------------------------------------------------------------------------
# Enable / Disable / FLush WiFi
#----------------------------------------------------------------------------------
function dwifi() {
  networksetup -setairportpower en0 off
}

function ewifi() {
  networksetup -setairportpower en0 on
}

function fwifi() {
  dwifi
  sleep 15
  sudo dscacheutil -flushcache; sudo killall -HUP mDNSResponder
  ewifi
}

#----------------------------------------------------------------------------------
# kill port function. e.g: kport 8080
#----------------------------------------------------------------------------------
function kport() {
  if [ -z "$1" ]; then
    echo "Usage: kport <port_number>"
    return 1
  fi

  PORT="$1"
  PID=$(lsof -ti :"$PORT")

  if [ -z "$PID" ]; then
    echo "No process found on port $PORT"
  else
    kill -9 "$PID"
    echo "The process $PID on port $PORT was killed!"
  fi
}

#----------------------------------------------------------------------------------
# Theme switching depending on the current macOS appearance
#----------------------------------------------------------------------------------
function themeToggle() {
  if [[ "$MACOS_CURRENT_THEME" == "Light" ]]; then
    # `zsh` autosuggest highlight
    if [[ "$SHELL" = "/bin/zsh" ]]; then
      ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#9e9e9e'
    fi

    # `lsd`
    if type lsd &> /dev/null; then
      ln -sfn light.yaml ~/.config/lsd/colors.yaml
    fi
  else
    # `lsd`
    if type lsd &> /dev/null; then
      ln -sfn dark.yaml ~/.config/lsd/colors.yaml
    fi
  fi
}

#----------------------------------------------------------------------------------
# Deletes the `n` previous commands from the history file. e.g.:
# rr!    -> deletes the previous command
# rr! 7  -> deletes the last 7 commands
#----------------------------------------------------------------------------------
function rr\!() {
  local nloop=${1:-2}

  if ! [[ "$nloop" =~ ^[0-9]+$ ]]; then
    echo ":: Please, enter a valid number"
    return
  fi

  if [[ -n "$1" ]]; then
    nloop=$((nloop + 1))
  fi

  if [[ "$SHELL" == *"zsh"* ]]; then
    FILENAME="${HISTFILE:-$HOME/.zsh_history}"
    for i in $(seq 1 "$nloop"); do
      fc -W
      if [[ "$(uname)" == "Darwin" ]]; then
        sed -i '' '$d' "$FILENAME"
      else
        sed -i '$d' "$FILENAME"
      fi
      fc -R
    done
    echo ":: Deleted ${1:-1} command(s) from zsh history"
  elif [[ "$SHELL" == *"bash"* ]]; then
    FILENAME="${HISTFILE:-$HOME/.bash_history}"
    for i in $(seq 1 "$nloop"); do
      history -w
      if [[ "$(uname)" == "Darwin" ]]; then
        sed -i '' '$d' "$FILENAME"
      else
        sed -i '$d' "$FILENAME"
      fi
      history -r
    done
    echo ":: Deleted ${1:-1} command(s) from bash history"
  else
    echo ":: I don't know which Shell you're using!"
    return
  fi
}

#----------------------------------------------------------------------------------
# Load the .env file from the current directory or any parent directory
#----------------------------------------------------------------------------------
function lenv() {
  local dir="$PWD"
  while [[ "$dir" != "/" ]]; do
    [[ -f "$dir/.env" ]] && { set -a && source "$dir/.env" && set +a; echo ":: Loaded $dir/.env"; return }
    dir="${dir:h}"
  done
  echo ":: No .env found"
}
